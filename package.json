{
  "name": "create-ranger",
  "version": "1.2.0",
  "description": "Scaffold production-ready monorepos with Next.js or React/Vite, Expo, tRPC, Better Auth, and Prisma.",
  "type": "module",
  "bin": {
    "create-ranger": "bin/ranger.js",
    "ranger": "bin/ranger.js",
    "renger": "bin/ranger.js"
  },
  "files": [
    "bin",
    "ranger.png",
    "README.md",
    "README.my.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check ./bin/ranger.js && node --check ./bin/manage-apps.js",
    "generate:desktop-app": "node ./scripts/generate-desktop-app.mjs",
    "smoke": "node ./scripts/smoke-test.mjs",
    "verify:generated": "RANGER_SMOKE_INSTALL=1 node ./scripts/smoke-test.mjs",
    "test": "pnpm run check && pnpm run smoke && node ./scripts/manage-apps-test.mjs",
    "prepublishOnly": "pnpm run test",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "keywords": [
    "ranger",
    "scaffold",
    "generator",
    "create-app",
    "monorepo",
    "nextjs",
    "vite",
    "tanstack-router",
    "expo",
    "trpc",
    "better-auth",
    "prisma",
    "turbo",
    "pnpm",
    "fullstack",
    "typescript"
  ],
  "author": "Rangorithm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rangorithm/ranger.git"
  },
  "bugs": {
    "url": "https://github.com/rangorithm/ranger/issues"
  },
  "homepage": "https://www.npmjs.com/package/create-ranger",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
